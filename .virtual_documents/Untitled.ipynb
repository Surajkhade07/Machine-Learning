import pandas as pd 


from sklearn.tree import DecisionTreeClassifier


data=pd.read_excel("iris-train Dataset.xlsx")


data.head()


data.info()


x=data.iloc[:,:-1]


y=data.iloc[:,-1]


model=DecisionTreeClassifier()


model.fit(x.values,y.values)


prediction=model.predict([[5.7	,2.5 ,5	,2
]])


prediction


prediction=model.predict([[5.7	,2.6	,3.5	,1
]])


prediction


prediction=model.predict([[5.8	,4	,1.2	,0.2
]])


prediction




